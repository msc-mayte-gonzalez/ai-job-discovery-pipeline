    {
      "parameters": {
        "jsCode": "// Representative demo only. Production workflow uses a much larger bilingual rule set.\nconst excluded = [\"engineer\", \"developer\", \"accountant\", \"nurse\", \"sales\", \"intern\"];\nconst exceptions = [\"ux engineer\"]; // example of how exceptions can override broad rules\n\nreturn $input.all().filter(item => {\n  const title = (item.json.title || \"\").toLowerCase();\n  if (exceptions.some(term => title.includes(term))) return true;\n  return !excluded.some(term => title.includes(term));\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        0
      ],
      "id": "c99ce24c-0ce5-402c-9a8b-3bf7ab421726",
      "name": "Title Pre-Filter"
    },
    {
      "parameters": {
        "jsCode": "// Representative demo only. Production workflow uses a broader city/country rule set.\nconst keep = [\"canada\", \"toronto\", \"montreal\", \"montréal\", \"vancouver\", \"remote\", \"not specified\"];\nconst drop = [\"united states\", \"usa\", \"new york\", \"boston\", \"germany\", \"united kingdom\"];\n\nreturn $input.all().filter(item => {\n  const location = (item.json.location || \"not specified\").toLowerCase();\n  if (keep.some(x => location.includes(x))) return true;\n  if (drop.some(x => location.includes(x))) return false;\n  return true; // keep ambiguous listings for later review\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
