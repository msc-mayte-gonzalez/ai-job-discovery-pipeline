    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const job = $json;\nconst cv = job.cv_graph;\n\nconst prompt = `You are a career matching assistant. Evaluate capability fit, not title similarity.\n\nRules:\n- Use only evidence in CANDIDATE.\n- Look for functional equivalence and transferable capability.\n- Be honest about genuine gaps.\n- Return ONLY valid JSON using the schema below.\n\n{\n  \"match_score\": 0.0,\n  \"fit_level\": \"strong | medium | weak\",\n  \"recommendation\": \"apply | consider | skip\",\n  \"overlap_skills\": [],\n  \"missing_skills\": [],\n  \"transferable_strengths\": [],\n  \"risk_factors\": [],\n  \"bridge_narrative\": \"\",\n  \"summary\": \"\"\n}\n\nCANDIDATE:\n${JSON.stringify(cv)}\n\nROLE:\nTITLE: ${job.title}\nCOMPANY: ${job.company}\nDESCRIPTION: ${job.description}`;\n\nreturn {\n  json: {\n    company: job.company,\n    title: job.title,\n    url: job.url,\n    haikuBody: JSON.stringify({\n      model: \"claude-haiku-4-5-20251001\",\n      max_tokens: 1200,\n      messages: [{ role: \"user\", content: prompt }]\n    })\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        0
      ],
      "id": "40265adc-0b13-460f-a44d-3864d6ebebde",
