    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const content = $json.content?.[0]?.text || '';\n\nconst cleaned = content\n  .replace(/```json\\n?/g, '')\n  .replace(/```\\n?/g, '')\n  .trim();\n\nlet result;\ntry {\n  result = JSON.parse(cleaned);\n} catch (e) {\n  return {\n    json: {\n      company: $('Build Prompt').item.json.company,\n      title: $('Build Prompt').item.json.title,\n      url: $('Build Prompt').item.json.url,\n      match_score: 0,\n      fit_level: 'unknown',\n      recommendation: 'skip',\n      summary: 'Parse error - could not read model response',\n      overlap_skills: '',\n      missing_skills: '',\n      transferable_strengths: '',\n      risk_factors: '',\n      bridge_narrative: '',\n      date: new Date().toISOString().split('T')[0]\n    }\n  };\n}\n\nreturn {\n  json: {\n    company: $('Build Prompt').item.json.company,\n    title: $('Build Prompt').item.json.title,\n    url: $('Build Prompt').item.json.url,\n    match_score: result.match_score,\n    fit_level: result.fit_level,\n    recommendation: result.recommendation,\n    bridge_narrative: result.bridge_narrative || '',\n    summary: result.summary,\n    overlap_skills: (result.overlap_skills || []).join(', '),\n    missing_skills: (result.missing_skills || []).join(', '),\n    transferable_strengths: (result.transferable_strengths || []).join(', '),\n    risk_factors: (result.risk_factors || []).join(', '),\n    date: new Date().toISOString().split('T')[0]\n  }\n};"
      },
