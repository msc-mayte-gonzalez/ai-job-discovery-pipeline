    {
      "parameters": {
        "jsCode": "const existingRows = $input.all();\n\nconst existingURLs = new Set(\n  existingRows\n    .map(row => (row.json.URL || row.json.url || '').trim())\n    .filter(url => url.length > 0)\n);\n\nconst existingTitles = new Set(\n  existingRows\n    .map(row => {\n      const company = (row.json.Company || row.json.company || '').trim().toLowerCase();\n      const title = (row.json.Title || row.json.title || '').trim().toLowerCase();\n      return company + '|' + title;\n    })\n    .filter(key => key !== '|')\n);\n\nconst incomingJobs = $('Location Filter').all();\n\nreturn incomingJobs.filter(item => {\n  const url = (item.json.url || '').trim();\n  const company = (item.json.company || '').trim().toLowerCase();\n  const title = (item.json.title || '').trim().toLowerCase();\n  const titleKey = company + '|' + title;\n  return !existingURLs.has(url) && !existingTitles.has(titleKey);\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        0
